<section aria-labelledby="related-articles-heading" class="mt-8 bg-[#262a31] border border-[#484833]/20 rounded-xl p-6 md:p-8">
  <h2 id="related-articles-heading" class="mt-0 uppercase tracking-widest text-[10px] font-['Space_Grotesk'] text-[#bdf4ff] mb-4">
    <span class="material-symbols-outlined text-[14px] align-middle mr-1" aria-hidden="true">folder_special</span>Related articles
  </h2>
  <ol id="related-articles" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% articles.each do |article| %>
      <li class="min-w-0">
        <%= link_to({ controller: 'articles', action: 'show', id: article.id, title: ArticlesHelper.friendly_title(article) },
                    class: 'group flex flex-col gap-2 h-full p-4 rounded-lg bg-[#10141a] border border-[#484833]/30 hover:border-[#D7DF21]/40 transition-colors duration-200 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#bdf4ff]') do %>
          <% if article.published_date.present? %>
            <time datetime="<%= format_date_microdata article.published_date %>" class="text-[10px] font-['Space_Grotesk'] tracking-widest uppercase text-[#c9c8ad]"><%= format_date article.published_date %></time>
          <% end %>
          <span class="font-['Space_Grotesk'] font-semibold leading-snug text-[#dfe2eb] group-hover:text-[#D7DF21] transition-colors duration-200 break-words"><%= article.title %></span>
          <span class="text-sm text-[#c9c8ad] leading-relaxed"><%= truncate(CGI.unescapeHTML(strip_tags(article.teaser.to_s)), length: 160, separator: ' ') %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</section>
