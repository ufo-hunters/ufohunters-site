<% article_url_options = { controller: 'articles', action: 'show', id: article.id, title: ArticlesHelper.friendly_title(article) } %>
<article class="glass-panel rounded-2xl border border-[#484833]/30 overflow-hidden flex flex-col">
  <% if article.image_thumbnail.present? %>
    <figure class="relative aspect-[16/9] lg:aspect-auto lg:h-36 xl:h-44 bg-[#10141a] overflow-hidden">
      <%= image_tag article.image_thumbnail, alt: article.title, decoding: 'async', class: 'absolute inset-0 w-full h-full object-cover' %>
      <div class="absolute inset-0 bg-gradient-to-t from-[#10141a]/80 via-transparent to-transparent" aria-hidden="true"></div>
    </figure>
  <% end %>
  <div class="flex flex-col gap-3 p-6">
    <span class="self-start inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#D7DF21]/10 border border-[#D7DF21]/30 text-[#D7DF21] text-[10px] font-['Space_Grotesk'] uppercase tracking-[0.2em]">
      <span class="material-symbols-outlined text-[14px]" aria-hidden="true">star</span>
      Featured Report
    </span>
    <h2 class="m-0 text-2xl xl:text-[28px] font-bold leading-tight text-[#dfe2eb] break-words">
      <%= link_to article.title, article_url_options, class: 'text-[#dfe2eb] hover:text-[#D7DF21] transition-colors duration-200 focus-visible:outline-none focus-visible:underline focus-visible:decoration-[#bdf4ff]' %>
    </h2>
    <p class="text-[#c9c8ad] leading-relaxed line-clamp-3 lg:line-clamp-2 xl:line-clamp-3"><%= truncate(CGI.unescapeHTML(strip_tags(article.teaser.to_s)), length: 220, separator: ' ') %></p>
    <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
      <% if article.published_date.present? %>
        <p class="text-xs font-['Space_Grotesk'] text-[#c9c8ad]">
          <span class="material-symbols-outlined text-[12px] align-middle mr-1" aria-hidden="true">schedule</span>
          <time datetime="<%= format_date_microdata article.published_date %>"><%= format_date article.published_date %></time>
        </p>
      <% end %>
      <%= link_to(article_url_options,
                  class: "inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-[#D7DF21] text-[#0a0e14] font-['Space_Grotesk'] font-bold uppercase tracking-widest text-xs hover:bg-[#bdf4ff] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#bdf4ff] focus-visible:ring-offset-2 focus-visible:ring-offset-[#10141a]") do %>
        Read the full article
        <span class="material-symbols-outlined text-[18px]" aria-hidden="true">arrow_forward</span>
      <% end %>
    </div>
  </div>
</article>
